# Copy to .env.local for development. Set the same keys in the Vercel dashboard
# (Project → Settings → Environment Variables) for preview/production.
# .env* is gitignored — never commit real values.

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://anchorsilvercapital.com"

# ── Email (Resend) — brochure + owner notification ──────────────────────────
# Create a key at https://resend.com/api-keys and verify the sending domain
# (SPF + DKIM + DMARC) before going live. Until RESEND_API_KEY is set the lead
# route still records the lead but sends no email.
RESEND_API_KEY=""
RESEND_FROM="Anchor Silver Capital <brochure@mail.anchorsilvercapital.com>"
OWNER_NOTIFY_EMAIL="leads@anchorsilvercapital.com"

# ── Spam protection (Cloudflare Turnstile) ──────────────────────────────────
# https://dash.cloudflare.com/?to=/:account/turnstile
# Until the secret is set, server-side verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Lead store (Turso) — deferred, add after the custom domain is assigned ───
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""

# ── CRM (GoHighLevel) — deferred, off until Ron's account exists ────────────
GHL_ENABLED="false"
# GHL_API_TOKEN=""
# GHL_LOCATION_ID=""
