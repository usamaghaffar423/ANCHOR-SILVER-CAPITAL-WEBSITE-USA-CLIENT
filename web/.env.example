# Copy to .env.local for development. Set the same keys in the Vercel dashboard
# (Project → Settings → Environment Variables) for preview/production.
# .env* is gitignored — never commit real values. All keys here are server-only.

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://anchorsilvercapital.com"

# ── Lead store (Turso / libSQL) ─────────────────────────────────────────────
# Create a DB at https://turso.tech, then: `turso db tokens create <db>`.
# Also backs /api/market's price-history fallback and the daily log-price cron.
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# ── Email (Resend) — brochure to the visitor + owner notification ───────────
# Key: https://resend.com/api-keys. The FROM domain must be verified in Resend
# (SPF + DKIM + DMARC) or sends fail (the lead is still saved).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional — overrides the default sender. Use a verified domain for testing.
RESEND_FROM="Anchor Silver Capital <info@anchorsilvercapital.com>"
OWNER_NOTIFY_EMAIL="leads@anchorsilvercapital.com"

# ── Brochure PDFs (Vercel Blob, public read) ────────────────────────────────
# Upload the PDFs to Vercel Blob and paste the public URLs here. If a PDF isn't
# ready, point at a placeholder URL — the email still sends with the link.
BLOB_URL_IRA_HANDBOOK="https://your-blob-store.public.blob.vercel-storage.com/ira-handbook.pdf"
BLOB_URL_PROSPECTUS="https://your-blob-store.public.blob.vercel-storage.com/prospectus.pdf"

# ── Market data (/api/market — hero's live price + trailing-12-month change) ─
# The 12-month change needs a historical silver price. Priority: (a) this API,
# (b) the silver_price_history table in Turso, (c) hidden if neither resolves.
METALS_API_KEY=""
METALS_PROVIDER="metalpriceapi"

# ── Cron (Vercel Cron → /api/cron/log-price) ────────────────────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET`. Unset = endpoint open.
CRON_SECRET=""

# ── GoHighLevel (lib/ghl) ───────────────────────────────────────────────────
# Auth mode 1 — long-lived Private Integration token (simplest; enough for
# single sub-account use). GHL → Settings → API & Webhooks → API Keys.
GHL_API_KEY=""
GHL_LOCATION_ID=""

# Auth mode 2 — OAuth 2.0 (Marketplace app). Set all four, then visit
# https://anchorsilvercapital.com/api/ghl/oauth once to grant access.
# Tokens are stored in the ghl_tokens table and auto-refreshed.
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""
GHL_REDIRECT_URI="https://anchorsilvercapital.com/api/ghl/oauth/callback"
# Optional: paste the Marketplace install link to skip the authorize URL build.
GHL_INSTALL_URL=""
# Space-separated scopes requested during OAuth.
#GHL_SCOPES="contacts.readonly contacts.write conversations.readonly conversations.write opportunities.readonly opportunities.write"
#GHL_USER_TYPE="Location"

# Lead push behavior (/api/lead → GHL contact + workflow)
# Optional — lead is added to this workflow when set (Automation → workflow URL).
GHL_WORKFLOW_ID=""
# Optional — JSON map of lead field → GHL custom field ID for custom-field sync,
# e.g. {"interest":"abc123","amountBracket":"def456","message":"ghi789"}
GHL_FIELD_MAP=""

# Optional — override GHL's Ed25519 webhook public key (tests / whitelabel senders).
#GHL_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
